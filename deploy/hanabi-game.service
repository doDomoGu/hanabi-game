[Unit]
Description=花火牌 HANABI
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hanabi-game/server
Environment=NODE_ENV=production
Environment=PORT=3011
ExecStart=/usr/local/bin/node /opt/hanabi-game/server/src/index.js
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
